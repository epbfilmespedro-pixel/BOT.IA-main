# BOT.IA — variáveis de ambiente opcionais
#
# O aplicativo funciona sem nenhuma variável definida: todos os valores abaixo
# são OBRIGATÓRIOS apenas quando você quiser sobrescrever o padrão.
#
# IMPORTANTE: o projeto não usa nenhuma biblioteca dotenv — o servidor lê as
# variáveis direto do processo (process.env). Este arquivo serve como contrato
# de documentação; para aplicar uma configuração, exporte a variável no shell
# antes de iniciar (ex.: $env:FREEBUFF_OLLAMA_PORT="11435"; npm start).
# No Electron empacotado, use o menu/setter do sistema operacional.
#
# -----------------------------------------------------------------------------
# Diretórios (resolvidos a partir dos valores abaixo; caminhos relativos são
# aceitos e resolvidos contra o diretório de trabalho atual)
# -----------------------------------------------------------------------------

# Raiz dos dados persistidos: settings.json, projects.json (registro),
# conversations/, memory/, checkpoints/, models.json, logs.
# Padrão: <raiz-do-projeto>/data
#FREEBUFF_DATA_DIR=D:/caminho/para/data

# Raiz onde os projetos criados pelo usuário são gravados (cada projeto em seu
# próprio diretório). Padrão: <raiz-do-projeto>/projects
#FREEBUFF_PROJECTS_DIR=D:/caminho/para/projects

# Modo opcional de projeto único ("pinned"): fixa um diretório como workspace
# inicial em vez de usar <projectsDir>/meu-projeto. Usado por testes e
# instalações fixas. Padrão: ausente (não fixado).
#FREEBUFF_WORKSPACE_DIR=D:/caminho/para/workspace

# -----------------------------------------------------------------------------
# Ollama (provedor local de modelos)
# -----------------------------------------------------------------------------

# Host do servidor Ollama (apenas host, sem http://). Padrão: 127.0.0.1
#FREEBUFF_OLLAMA_HOST=127.0.0.1

# Porta do servidor Ollama (1-65535; valores fora da faixa caem no padrão).
# Padrão: 11434
#FREEBUFF_OLLAMA_PORT=11434

# Modelo usado como padrão quando não há escolha persistida. Padrão: vazio
# (nenhum modelo fixado no código — a interface permite troca dinâmica).
#FREEBUFF_DEFAULT_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Portas do próprio app (lidas em server/index.js; com fallback automático
# para a próxima porta livre quando a inicial estiver em uso)
# -----------------------------------------------------------------------------

# Porta inicial do servidor da interface/API. Padrão: 4180
#FREEBUFF_APP_PORT=4180

# Porta inicial do servidor de preview (origem isolada do chat). Padrão: 4181
#FREEBUFF_PREVIEW_PORT=4181

# Porta do endpoint CDP usado pelos probes de automação. Padrão: 9222
#FREEBUFF_CDP_PORT=9222

# -----------------------------------------------------------------------------
# Free Claude Code (catálogo opcional, desativado por padrão)
# -----------------------------------------------------------------------------
# Para habilitar, inclua free-claude-code em BOTIA_PROVIDERS.
# O FCC precisa escutar SOMENTE em 127.0.0.1 e ter PROXY_AUTH_ENABLED=true.
# Use o mesmo token aleatório de pelo menos 32 caracteres em ANTHROPIC_AUTH_TOKEN (FCC) e BOTIA_FCC_API_KEY (BOT.IA); não use o padrão conhecido freecc.
# BOT.IA recusa consultar o FCC se BOTIA_FCC_API_KEY estiver vazia.
# BOTIA_FCC_BASE_URL=http://127.0.0.1:8082
# BOTIA_FCC_API_KEY=
# Lista EXATA de IDs que você conferiu individualmente como gratuitos no provedor.
# Sem IDs nesta lista, nenhum modelo FCC aparece. Sufixos :free e /free não provam gratuidade.
# BOTIA_FCC_FREE_MODEL_IDS=provider/exact-model-id-verified-free
# No FCC, mantenha MODEL FALLBACKS vazio ou restrito à mesma lista de modelos verificados.
# Só depois de confirmar essa configuração no painel FCC, defina BOTIA_FCC_FALLBACKS_CONFIRMED=true.
# BOT.IA não consegue inspecionar os fallbacks internos por API; a variável acima é uma confirmação manual.
# BOTIA_FCC_FALLBACKS_CONFIRMED=true
# Timeout da geração FCC, em milissegundos (1.000–900.000; padrão 300.000).
# BOTIA_FCC_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Pesquisa web opcional (Exa) — desligada por padrão na configuração do app
# -----------------------------------------------------------------------------
# Ao ativar a pesquisa web na aplicação, é necessária uma chave de API externa.
# A consulta de pesquisa será enviada ao serviço Exa; não inclua segredos nem
# conteúdo privado de ficheiros na consulta.
#BOTIA_WEB_SEARCH_API_KEY=
# Alternativa equivalente à variável acima:
#EXA_API_KEY=
# Endpoint HTTPS opcional; por padrão usa https://api.exa.ai/search
#BOTIA_WEB_SEARCH_ENDPOINT=https://api.exa.ai/search
# Timeout em milissegundos (250–15000; padrão 8000)
#BOTIA_WEB_SEARCH_TIMEOUT_MS=8000
# Máximo de resultados (o valor é limitado pelo contrato do produto)
#BOTIA_WEB_SEARCH_MAX_RESULTS=5
# Máximo do corpo de resposta em bytes (padrão e máximo 1048576)
#BOTIA_WEB_SEARCH_MAX_RESPONSE_BYTES=1048576

# -----------------------------------------------------------------------------
# Geração multimodal local opcional (não descarrega modelos nem chama serviços remotos)
# Os endpoints devem apontar para workers HTTP em localhost/loopback.
# Contrato e limites: docs/multimodal-generation.md
# BOTIA_IMAGE_GENERATION_URL=http://127.0.0.1:7860/api/image/generate
# BOTIA_IMAGE_GENERATION_API_KEY=
# BOTIA_AUDIO_GENERATION_URL=http://127.0.0.1:7861/api/audio/generate
# BOTIA_AUDIO_GENERATION_API_KEY=
#
# Para tarefas normais do agente, 0 desativa o watchdog de inatividade explicitamente.
# BOTIA_RUN_INACTIVITY_MS=0
# Aumentado para 15 min por padrão para dar espaço a inferência local pesada.
# BOTIA_FIRST_OUTPUT_TIMEOUT_MS=900000
